# Anchor lib/ to repo root — Python's installed-packages dir lives at ./lib/
# Without the leading slash, this rule would also exclude nested lib/ dirs
# like frontend/client/src/lib/ (which is a legitimate TypeScript module).
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
