{
  "name": "hakusai-motion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:startup": "remotion render src/index.ts HakusStartup out/hakus-startup.mp4",
    "render:awakening": "remotion render src/index.ts HakusAwakening out/hakus-awakening.mp4",
    "render:awakening-light": "remotion render src/index.ts HakusAwakeningLight out/hakus-awakening-light.mp4",
    "render:first-run": "remotion render src/index.ts HakusFirstRun out/hakus-first-run.mp4",
    "render:long-run": "remotion render src/index.ts HakusLongRunning out/hakus-long-running.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.523",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.523"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.3",
    "typescript": "^5.8.3"
  }
}
