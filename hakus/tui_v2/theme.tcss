/* HakusAI TUI v2 — OpenCode 源码级精确风格
 * 基于 packages/tui/src/routes/session/index.tsx 分析
 * 深色背景、低对比度边框、最小视觉噪音
 */

Screen {
    background: #0a0a0a;
    color: #eeeeee;
}

/* === OpenCode Session 水平分屏布局 === */
/* flexDirection="row": 左侧 flexGrow=1 + 右侧 width=42 */
#top-pane {
    height: 1fr;
    background: #0a0a0a;
}

/* 左侧内容区: flexGrow=1, paddingLeft=2, paddingRight=2, paddingBottom=1 */
#messages-pane {
    width: 1fr;
    background: #0a0a0a;
    padding: 0 2 1 2;
    overflow: hidden;
}

/* 右侧侧边栏: width=42, paddingTop/Bottom=1, paddingLeft/Right=2 */
#sidebar {
    width: 42;
    background: #0a0a0a;
    border-left: solid #1e1e1e;
    padding: 1 2;
    overflow: auto;
}

/* 窄屏隐藏侧边栏 (width <= 120) */
#sidebar.hidden {
    display: none;
}

/* === Message List (scrollbox, flexGrow=1) === */
#message-list {
    padding: 0;
    background: #0a0a0a;
    scrollbar-size: 1 0;
    height: 1fr;
    overflow: auto;
}

#message-list > .scrollbar {
    background: #0a0a0a;
}

#message-list > .scrollbar > .scrollbar-thumb {
    background: #282828;
    min-height: 1;
}

#message-list > .scrollbar > .scrollbar-thumb:hover {
    background: #3c3c3c;
}

/* === User Bubble === */
UserBubble {
    background: #0a0a0a;
    margin: 1 0;
    padding: 0 1;
    height: auto;
    border-left: tall #3c3c3c;
}

/* === Assistant Text === */
AssistantText {
    margin: 1 0;
    padding: 0 1;
    height: auto;
    background: transparent;
}

/* === Tool Result (紧凑) === */
ToolResult {
    margin: 0;
    padding: 0 1;
    height: auto;
    background: transparent;
    border-left: tall #1e1e1e;
}

ToolResult.expanded {
    border-left: tall #e5c07b;
}

ToolResult.error {
    border-left: tall #e06c75;
}

/* === Command Result === */
CommandResult {
    margin: 0;
    padding: 0 1;
    background: transparent;
    border-left: tall #282828;
    height: auto;
}

/* === Error Block === */
ErrorBlock {
    margin: 1 0;
    padding: 0 1;
    background: transparent;
    border-left: tall #e06c75;
    height: auto;
}

/* === Welcome Panel === */
WelcomePanel {
    background: transparent;
    padding: 1 2;
    height: auto;
    max-width: 75;
    margin: 1 0;
}

/* === Activity Strip === */
#activity-strip {
    height: 1;
    background: #0a0a0a;
    color: #56b6c2;
    padding: 0 1;
    display: none;
    dock: top;
}

#activity-strip.active {
    display: block;
}

/* === Prompt Input (flexShrink=0, 底部固定) === */
/* OpenCode: Prompt = textarea + agent/model行 + 底部提示行 */
#prompt-input {
    dock: bottom;
    height: auto;
    min-height: 3;
    max-height: 24;
    background: #0a0a0a;
    border-top: solid #1e1e1e;
}

/* === Notification Bar === */
#notification-bar {
    height: 1;
    background: #0a0a0a;
    color: #56b6c2;
    padding: 0 1;
}

/* === Thinking Block === */
ThinkingBlock {
    margin: 0;
    padding: 0 1;
    background: transparent;
    border-left: tall #1e1e1e;
    height: auto;
}

ThinkingBlock .thinking-summary {
    color: #606060;
    text-style: italic;
}

ThinkingBlock .thinking-content {
    color: #808080;
    padding-left: 2;
}

/* === Permission Dialog === */
PermissionDialog {
    background: #0a0a0a 90%;
}

PermissionDialog .modal {
    background: #0a0a0a;
    border: tall #5c9cf5;
}
